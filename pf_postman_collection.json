{
  "info": {
    "name": "PF API - Comprehensive Test Suite",
    "description": "Coleção completa para testar a API REST de usuários e projetos. Execute as requisições na ordem: primeiro crie usuário e projeto, depois teste as operações. As variáveis created_user_id e created_project_id são automaticamente definidas pelos testes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.1.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "2"
    },
    {
      "key": "created_user_id",
      "value": ""
    },
    {
      "key": "created_project_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0️⃣ Setup - Criar recursos base",
      "description": "Execute estas requisições primeiro para criar usuário e projeto que serão usados nos testes",
      "item": [
        {
          "name": "🚀 Criar usuário para testes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-USER-ID",
                "value": "{{admin_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Teste\",\n  \"cpf\": \"12345678901\",\n  \"papel\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.collectionVariables.set('created_user_id', responseJson.id);",
                  "    console.log('Usuário criado com ID:', responseJson.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "🚀 Criar projeto para testes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-USER-ID",
                "value": "{{admin_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Projeto Teste\",\n  \"descricao\": \"Projeto para testes\",\n  \"usuarioIds\": [1]\n}"
            },
            "url": {
              "raw": "{{base_url}}/projetos",
              "host": ["{{base_url}}"],
              "path": ["projetos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.collectionVariables.set('created_project_id', responseJson.id);",
                  "    console.log('Projeto criado com ID:', responseJson.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
